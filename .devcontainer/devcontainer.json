// For format details, see https://aka.ms/devcontainer.json.
{
  "name": "ricochet-app",
  // The Dockerfile builds on the Ubuntu base image and installs GitHub CLI and Claude Code from
  // their apt repositories. They aren't features: a feature bakes a fixed version into the cached
  // image layer, which only a no-cache rebuild refreshes, while apt can upgrade them on every
  // start (postStartCommand).
  "build": {
    "dockerfile": "Dockerfile"
  },

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    // Same major version as the Node used in CI (node-version in .github/workflows).
    "ghcr.io/devcontainers/features/node:2.1.1": { "version": "24" },
    // Compose isn't used. Skipping it also skips the feature's download from GitHub releases,
    // which fails the whole image build whenever GitHub returns a 5xx.
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": { "dockerDashComposeVersion": "none" }
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // 5173 is the default port for Vite. 54321-54324 are the local Supabase API, database, Studio
  // and Inbucket (email) ports from supabase/config.toml: `supabase start` runs inside the
  // container's own Docker, and forwarding them keeps the URLs the same on the host.
  "forwardPorts": [5173, 54321, 54322, 54323, 54324],

  // Keep node_modules and .playwright-browsers in container-only named volumes. The repo is bind-mounted from the
  // host, and npm only installs native optional deps (e.g. @rolldown/binding-*) for the OS it
  // runs on, so sharing node_modules between macOS and Linux breaks Vite/Vitest on one side.
  // Playwright has the same problem: it marks a browser folder as installed per version, so a
  // macOS host would skip downloading its own build once the container installed the Linux one
  // into the shared folder.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-playwright-browsers,target=${containerWorkspaceFolder}/.playwright-browsers,type=volume",
    "source=${localWorkspaceFolderBasename}-claude-config,target=/home/vscode/.claude,type=volume",
    "source=${localWorkspaceFolderBasename}-gh-config,target=/home/vscode/.config/gh,type=volume"
  ],

  // Docker creates a new volume, and any missing parent folder of its mount point (here
  // ~/.config), owned by root. Hand them to vscode before anything writes to them. It runs
  // once, before postCreateCommand, so nothing there races the chown.
  "onCreateCommand": "sudo chown vscode:vscode /home/vscode/.config /home/vscode/.config/gh /home/vscode/.claude",

  // Puts project CLIs (openspec, supabase, ...) on PATH, so agents and terminals can run them
  // bare. The OpenSpec skills call `openspec` directly and pre-approve only `Bash(openspec:*)`.
  // CLAUDE_CONFIG_DIR keeps Claude Code's ~/.claude.json inside the ~/.claude volume too, so
  // login and onboarding state survive a rebuild. Bash history is deliberately not persisted: a
  // secret typed or pasted into a terminal (an API key) must not outlive the container.
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}",
    "CLAUDE_CONFIG_DIR": "/home/vscode/.claude"
  },

  // Runs once after the container is created.
  // installPlaywright installs the OS-level libraries Chromium needs to launch (apt packages
  // aren't in the base image) before downloading Playwright's browser binaries, so Playwright's
  // post-download host-requirements check doesn't fail with a "missing dependencies"
  // warning on every fresh build.
  // It passes PATH through sudo: sudo resets PATH, and Node (installed by nvm) isn't on the
  // default one, so a bare `sudo npx` fails with "command not found".
  "postCreateCommand": "sudo chown vscode:vscode node_modules .playwright-browsers && npm ci && sudo env \"PATH=$PATH\" npx playwright install-deps chromium && npm run test:e2e:setup",

  // Runs on every container start, including restarts that don't rebuild it, so GitHub CLI and
  // Claude Code are on the latest release before the first session. A failed or timed-out update
  // (e.g. offline) doesn't fail the start: it prints the exit code (124 is a timeout) and the
  // next start tries again. It ends by printing the installed versions. apt installs don't update
  // themselves, so this is the only place they are upgraded.
  "postStartCommand": {
    "updateGhAndClaude": "sudo timeout 120 apt-get update -qq --error-on=any || echo \"apt update failed or timed out (exit $?); GitHub CLI and Claude Code may be out of date\"; sudo timeout 300 apt-get install -y -qq --only-upgrade gh claude-code || echo \"apt upgrade failed or timed out (exit $?)\"; gh --version | head -1; claude --version || true"
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "vitest.explorer",
        "RobBos.ai-engineering-fluency",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-containers",
        "dbaeumer.vscode-eslint",
        "ms-vscode.live-server",
        "ms-playwright.playwright",
        "esbenp.prettier-vscode",
        "Supabase.vscode-supabase-extension",
        "redhat.vscode-yaml",
        "github.vscode-github-actions",
        "anthropic.claude-code"
      ]
    }
  },

  // Connect as the base image's non-root user.
  "remoteUser": "vscode"
}

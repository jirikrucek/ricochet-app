// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
  "name": "ricochet-app",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/base:resolute",

  // Features to add to the dev container. More info: https://containers.dev/features.
  // Claude Code is not a feature: a feature bakes a root-owned binary into the cached image
  // layer, which its own updater can't replace, so it stays old until a no-cache rebuild.
  // postCreateCommand installs it with the official installer instead.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/copilot-cli:1.1.3": {},
    "ghcr.io/devcontainers/features/node:2.1.1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // 5173 is the default port for Vite
  "forwardPorts": [5173],

  // Keep node_modules and .playwright-browsers in container-only named volumes. The repo is bind-mounted from the
  // host, and npm only installs native optional deps (e.g. @rolldown/binding-*) for the OS it
  // runs on, so sharing node_modules between macOS and Linux breaks Vite/Vitest on one side.
  // Playwright has the same problem: it marks a browser folder as installed per version, so a
  // macOS host would skip downloading its own build once the container installed the Linux one
  // into the shared folder.
  "mounts": [
    "source=${localWorkspaceFolderBasename}-node_modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=${localWorkspaceFolderBasename}-playwright-browsers,target=${containerWorkspaceFolder}/.playwright-browsers,type=volume"
  ],

  // Puts project CLIs (openspec, supabase, ...) on PATH, so agents and terminals can run them
  // bare. The OpenSpec skills call `openspec` directly and pre-approve only `Bash(openspec:*)`.
  // Also puts ~/.local/bin, where the Claude Code installer puts `claude`, on PATH outside
  // interactive shells too.
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerWorkspaceFolder}/node_modules/.bin:${containerEnv:PATH}"
  },

  // Use 'postCreateCommand' to run commands after the container is created.
  // Installs the OS-level libraries Chromium needs to launch (apt packages aren't in
  // the base image) before downloading Playwright's browser binaries, so Playwright's
  // post-download host-requirements check doesn't fail with a "missing dependencies"
  // warning on every fresh build.
  // Also preserves HOME (in addition to PATH) when sudo'ing: node-asdf's `npx` shim
  // resolves the active Node version via $HOME/.tool-versions, and sudo resets HOME
  // to /root by default, which breaks shim resolution ("unknown command: npx").
  // installClaude installs the latest Claude Code into ~/.local/bin, owned by vscode, so its
  // own updater can keep it current.
  "postCreateCommand": {
    "installPlaywright": "sudo chown vscode:vscode node_modules .playwright-browsers && npm ci && sudo env \"PATH=$PATH\" \"HOME=$HOME\" npx playwright install-deps chromium && npm run test:e2e:setup",
    "installClaude": "curl -fsSL https://claude.ai/install.sh | bash"
  },

  // Runs on every container start, including restarts that don't rebuild it, so Claude Code is
  // on the latest version before the first session.
  "postStartCommand": {
    "updateClaude": "/home/vscode/.local/bin/claude update"
  },

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": [
        "vitest.explorer",
        "RobBos.ai-engineering-fluency",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-containers",
        "dbaeumer.vscode-eslint",
        "ms-vscode.live-server",
        "ms-playwright.playwright",
        "esbenp.prettier-vscode",
        "Supabase.vscode-supabase-extension",
        "redhat.vscode-yaml",
        "github.vscode-github-actions"
      ]
    }
  },

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  "remoteUser": "vscode"
}

{
  // Solution-style: the editor opens each file with the config that includes
  // it. npm run typecheck checks the two configs with tsc -p (ADR 0025).
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  "compilerOptions": {
    // The shadcn CLI resolves components.json aliases from this file only.
    // Keep in sync with tsconfig.app.json.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
